# PostgreSQL connection for Prisma (chat, instructions, AI logs)
#
# Mac (Homebrew Postgres): use your macOS username, often no password locally:
#   postgresql://YOUR_MAC_USERNAME@localhost:5432/aurynadmin?schema=public
#
# Create DB once:  createdb aurynadmin
# Or:            psql -d postgres -c "CREATE DATABASE aurynadmin;"
DATABASE_URL=""

# Session signing (min 32 characters). Generate: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
# PostgreSQL — local Homebrew Postgres (Mac default superuser = your macOS username)

# Initial admin seed (npm run db:seed)
ADMIN_EMAIL="auryn@gmail.com"
ADMIN_PASSWORD="1234567890"

# Optional: end-user chat app URL for "Back to chat" in admin header
# NEXT_PUBLIC_USER_CHAT_URL="https://chat.auryn.example"

# Public chat (Feature 5) — server-side only, never expose to browser
# OPENAI_API_KEY=
# OPENAI_MODEL="gpt-4o-mini"
